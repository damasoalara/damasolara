# Cloudflare Pages security headers (applied at the edge to every response)
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), accelerometer=(self), gyroscope=(self), magnetometer=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; media-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; upgrade-insecure-requests

# HTML: no-transform stops Cloudflare's edge from injecting its Web Analytics beacon, which the
# CSP (rightly) blocks and logs as an error on every page. Fix the injection, never loosen the CSP.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/index.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform

# Media filenames are not content-hashed, so photos can be swapped in place.
# Cache briefly, then revalidate (ETag) so replacements go live without a rename.
/images/*
  Cache-Control: public, max-age=3600, must-revalidate
/video/*
  Cache-Control: public, max-age=86400, must-revalidate

# Private brandscript: encrypted page. Keep it and its photos out of search, AI and archives.
# robots.txt also disallows both paths (the page is encrypted, so naming the path reveals nothing).
/brandscript/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex, notranslate, noai, noimageai
  Cache-Control: private, no-store, no-transform
/images/brandscript/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex, notranslate, noai, noimageai
  Cache-Control: private, no-store
